# Township Configuration
DOMAIN=localhost
ADMIN_EMAIL=admin@localhost

# Database - CHANGE IN PRODUCTION
DB_USER=township
DB_PASSWORD=your-secure-database-password
DB_NAME=township_db
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Security - CHANGE IN PRODUCTION
# Generate with: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-change-me

# Initial Admin Account (bootstrap only)
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change-me-in-production

# Google Cloud (Optional - for AI features and Secret Manager)
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1

# Google Maps (Optional - for maps and translation)
GOOGLE_MAPS_API_KEY=

# Accela sign-in (Optional - one developer-portal app serves every town, so
# these are deployment-level. Without them the Accela wizard falls back to
# asking for an agency username and password. See docs/INTEGRATIONS.md.)
ACCELA_CLIENT_ID=
ACCELA_CLIENT_SECRET=
# Only when the callback registered on the Accela app is not
# https://<your-domain>/api/integrations/accela/oauth/callback
ACCELA_REDIRECT_URI=

# Deployment registration form (Optional - the URL of a form the operator
# hosts, e.g. a Microsoft Form, collecting a point of contact and deployment
# details. When set, the admin console offers it instead of the built-in
# contact form. Leave empty to keep the in-app form.)
#
# To have the console fill in what it already knows, use Microsoft Forms'
# "Collect responses > Get pre-filled URL", then replace each sample answer in
# the URL it gives you with one of these tokens:
#
#   {organization}     the township name from branding
#   {deployment_url}   the address residents use
#   {version}          the running build
#   {contact_name}     the signed-in administrator's name     <- personal data
#   {contact_email}    the signed-in administrator's email    <- personal data
#   {contact_role}     the signed-in administrator's role
#
# Only tokens you paste are ever sent; the two marked above are somebody's
# personal data, so include them only if you want the form pre-filled with the
# details of whoever is signed in. Example:
#
#   CONTACT_FORM_URL=https://forms.office.com/Pages/ResponsePage.aspx?id=AB12&r1f0c={organization}&r6b42={deployment_url}
CONTACT_FORM_URL=

# Show that form inside the console in a frame, so it can be answered without
# leaving the page (default true). Set false for a form restricted to your own
# organisation -- those render a sign-in page in a frame rather than the
# questions -- which sends people to a new tab instead. A form hosted somewhere
# other than Microsoft Forms also needs its host added to frame-src in the
# Caddyfile before it can be framed.
CONTACT_FORM_EMBED=true

# Frontend
FRONTEND_PORT=5173

# Web Server Ports (change if ports 80/443 are already in use)
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=8000
