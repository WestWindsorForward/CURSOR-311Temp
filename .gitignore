# Environment files
.env
.env.local
.env.*.local

# Dependencies
node_modules/
# Without this, a node_modules *symlink* is not ignored -- only the directory
# form is. One `git add -A` committed such a link, and a later `git checkout -f`
# then materialised it over the real install and deleted it.
node_modules
__pycache__/
*.pyc
.pytest_cache/

# Build outputs
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker volumes
postgres_data/
caddy_data/
caddy_config/

# Uploaded files (persisted via Docker volumes, must survive git operations)
uploads/

# Credentials
*.pem
*.key
service-account.json

# GitLab Secret Detection / Gitleaks scan artifacts
gl-secret-detection-report.json
gl-*-report.json
backend/celerybeat-schedule
